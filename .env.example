# Local development settings. Copy to .env and change keys before any real use.
MEMORY_GATEWAY_DATABASE_URL=sqlite:///./memory_gateway.db
MEMORY_GATEWAY_ADMIN_KEY=admin-demo-key
MEMORY_GATEWAY_BACKEND_KEY=backend-demo-key
MEMORY_GATEWAY_GUEST_KEY=guest-demo-key

# Optional graph backend. Core flows degrade gracefully when Neo4j is unavailable.
MEMORY_GATEWAY_GRAPH_ENABLED=true
MEMORY_GATEWAY_NEO4J_URI=bolt://127.0.0.1:7687
MEMORY_GATEWAY_NEO4J_USER=neo4j
MEMORY_GATEWAY_NEO4J_PASSWORD=memorypassword
MEMORY_GATEWAY_NEO4J_DATABASE=neo4j

# Optional desktop/API CORS override.
MEMORY_GATEWAY_CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,http://tauri.localhost,tauri://localhost
